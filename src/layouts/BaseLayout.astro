---
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-400-italic.css";
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/ia-writer-mono/latin-400.css";
import "../styles/globals.css";
import { ClientRouter } from "astro:transitions";

import TopContent from "../components/shared/topContent/TopContent.astro";
import Footer from "../components/shared/footer/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  canonical?: string;
  wide?: boolean;
}

const desc =
  "Software, systems, and the bits in between. Technical writing, projects, and personal Mumblings by Matt Bidewell, a practicing software engineer.";

const {
  title = "matty.dev",
  description = desc,
  ogImage,
  ogType = "website",
  canonical,
  wide = false,
} = Astro.props;

const fullTitle = title.toLowerCase() === "matty.dev" ? "matty.dev" : `${title} | matty.dev`;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ?? new URL("/opengraph-image.png", Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let preference;
        try { preference = localStorage.getItem('matty-theme'); } catch {}
        if (preference !== 'light' && preference !== 'dark') preference = null;
        const media = matchMedia('(prefers-color-scheme: dark)');
        function apply(root = document.documentElement) {
          root.dataset.theme = preference || (media.matches ? 'dark' : 'light');
        }
        function label() {
          const dark = document.documentElement.dataset.theme === 'dark';
          document.querySelectorAll('[data-theme-toggle]').forEach(button => {
            button.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
          });
        }
        apply();
        document.addEventListener('astro:before-swap', event => apply(event.newDocument.documentElement));
        document.addEventListener('astro:page-load', label);
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
          preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('matty-theme', preference); } catch {}
          apply();
          label();
        });
        media.addEventListener('change', () => { if (!preference) { apply(); label(); } });
      })();
    </script>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Matty.dev" />
    <meta name="author" content="Matthew Bidewell" />
    <meta name="creator" content="Matthew Bidewell" />
    <meta name="publisher" content="Matthew Bidewell" />
    <meta
      name="keywords"
      content="Matthew Bidewell, Matt Bidewell, software Engineer"
    />

    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="apple-touch-icon" href="/avatar.webp" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@mattbidewell" />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" type="application/rss+xml" title="Matty.dev RSS" href="/rss.xml" />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <TopContent />
      <main id="main-content" class:list={["page-content", { "page-content--wide": wide }]} tabindex="-1">
        <div class="route-content">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
