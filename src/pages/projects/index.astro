---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListHeader from "../../components/posts/ListHeader.astro";
import PostList from "../../components/posts/PostList.astro";
import { getLivePosts } from "../../lib/posts";

const projects = await getLivePosts("project");
---

<BaseLayout title="Projects" kind="index">
  <ListHeader
    kind="Section"
    title="Projects"
    description="Things I've been building, and what I learned building them."
    count={projects.length}
    noun="project"
  />
  <PostList posts={projects} />
</BaseLayout>
