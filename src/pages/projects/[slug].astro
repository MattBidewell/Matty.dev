---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostBody from "../../components/blog/body/PostBody.astro";
import PostFooter from "../../components/blog/footer/PostFooter.astro";
import PostHeader from "../../components/blog/PostHeader.astro";
import styles from "../../components/blog/Project.module.css";
import { getLivePosts, rawSlug, readingStats } from "../../lib/posts";

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getLivePosts("project");
  return projects.map((project) => ({
    params: { slug: rawSlug(project) },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content, headings } = await project.render();
const stats = readingStats(project);
const techStack = project.data.tech_stack ?? [];
---

<BaseLayout
  title={project.data.title}
  description={project.data.excerpt ?? ""}
  ogType="article"
  kind="post"
  toc={headings}
  stats={stats}
>
  <article class={styles.project}>
    <PostHeader
      category="project"
      title={project.data.title}
      excerpt={project.data.excerpt}
      stats={stats}
    >
      {
        (techStack.length > 0 || project.data.github_url || project.data.demo_url) && (
          <dl class={styles.meta}>
            {techStack.length > 0 && (
              <div>
                <dt>stack</dt>
                <dd>{techStack.join(", ").toLowerCase()}</dd>
              </div>
            )}
            {(project.data.github_url || project.data.demo_url) && (
              <div>
                <dt>links</dt>
                <dd class={styles.links}>
                  {project.data.github_url && (
                    <a href={project.data.github_url} target="_blank" rel="noopener noreferrer">GitHub</a>
                  )}
                  {project.data.demo_url && (
                    <a href={project.data.demo_url} target="_blank" rel="noopener noreferrer">Live demo</a>
                  )}
                </dd>
              </div>
            )}
          </dl>
        )
      }
    </PostHeader>

    <PostBody>
      <Content />
    </PostBody>
    <PostFooter />
  </article>
</BaseLayout>
