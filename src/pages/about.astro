---
import BaseLayout from "../layouts/BaseLayout.astro";

const yearsExp = new Date().getFullYear() - 2015;
---

<BaseLayout title="About">
  <article class="about">
    <header>
      <h1>About</h1>
      <p class="intro">
        I&apos;m Matt Bidewell, a software engineer with {yearsExp}+ years of
        experience building products on the web.
      </p>
    </header>
    <section aria-labelledby="work">
      <h2 id="work">Work</h2>
      <p>
        I currently work as a Senior Software Engineer at{" "}
        <a target="_blank" rel="noreferrer" href="https://www.contentful.com/">
          Contentful
        </a>, and I enjoy shipping reliable systems, writing clearly, and working
        in the open.
      </p>
      <p class="resume">
        <a target="_blank" rel="noopener" href="/assets/resume/Matt-Bidewell-Resume.pdf">
          View resume
        </a>
      </p>
    </section>
    <section aria-labelledby="elsewhere">
      <h2 id="elsewhere">Elsewhere</h2>
      <p>
        You can find me on{" "}
        <a target="_blank" rel="noopener noreferrer" href="https://x.com/MattBidewell">
          X (formerly Twitter)
        </a>, browse my work on{" "}
        <a target="_blank" rel="noopener noreferrer" href="https://www.github.com/mattbidewell">
          GitHub
        </a>, or connect via{" "}
        <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/matt-bidewell-a4578790/">
          LinkedIn
        </a>.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  h1 {
    margin: 0 0 1.5rem;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .intro {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  section {
    margin-top: 2rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  p {
    margin: 0 0 1.25rem;
  }

  .resume {
    margin-bottom: 0;
  }
</style>
