---
import BaseLayout from "../layouts/BaseLayout.astro";

const yearsExp = new Date().getFullYear() - 2015;
---

<BaseLayout title="About">
  <article class="about">
    <header>
      <p class="eyebrow">Page</p>
      <h1>About</h1>
      <p class="intro">
        I&apos;m Matt Bidewell, a software engineer with {yearsExp}+ years of
        experience building products on the web.
      </p>
    </header>
    <section aria-labelledby="work">
      <h2 id="work">Work</h2>
      <p>
        I currently work as a Senior Software Engineer at{" "}
        <a target="_blank" rel="noreferrer" href="https://www.contentful.com/">
          Contentful
        </a>, and I enjoy shipping reliable systems, writing clearly, and working
        in the open.
      </p>
      <p class="resume">
        <a target="_blank" rel="noopener" href="/assets/resume/Matt-Bidewell-Resume.pdf">
          View resume
        </a>
      </p>
    </section>
    <section aria-labelledby="elsewhere">
      <h2 id="elsewhere">Elsewhere</h2>
      <p>
        You can find me on{" "}
        <a target="_blank" rel="noopener noreferrer" href="https://x.com/MattBidewell">
          X (formerly Twitter)
        </a>, browse my work on{" "}
        <a target="_blank" rel="noopener noreferrer" href="https://www.github.com/mattbidewell">
          GitHub
        </a>, or connect via{" "}
        <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/matt-bidewell-a4578790/">
          LinkedIn
        </a>.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .about header {
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--text-heading);
  }

  h1 {
    margin: 0 0 1rem;
  }

  .intro {
    max-width: 38rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  section {
    margin-top: 2.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  h2::before {
    content: "# ";
    color: var(--accent-primary);
  }

  .resume {
    margin-bottom: 0;
  }
</style>
