---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLivePosts, linkSlugFor } from '../lib/posts';
import styles from './home.module.css';

const projects = (await getLivePosts('project')).slice(0, 3);
const posts = (await getLivePosts('blog')).slice(0, 3);
const mumblings = (await getLivePosts('mumbling')).slice(0, 3);
---

<BaseLayout>
  <div class={styles.home} data-home-content>
    <section class={styles.intro} aria-labelledby="intro-title">
      <h1 id="intro-title">Matt Bidewell</h1>
      <p class={styles.description}>Software engineer, product builder, and writer.</p>
    </section>

    {projects.length > 0 && (
      <section class={styles.section} aria-labelledby="projects-title">
        <div class={styles.sectionHeading}>
          <h2 id="projects-title">Projects</h2>
        </div>
        <ul class={styles.entries} role="list">
          {projects.map(project => (
            <li>
              <a href={linkSlugFor(project)}>{project.data.title}</a>
            </li>
          ))}
        </ul>
        <a class={styles.more} href="/projects">More projects</a>
      </section>
    )}

    {posts.length > 0 && (
      <section class={styles.section} aria-labelledby="posts-title">
        <div class={styles.sectionHeading}>
          <h2 id="posts-title">Posts</h2>
        </div>
        <ul class={styles.entries} role="list">
          {posts.map(post => (
            <li>
              <a href={linkSlugFor(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
        <a class={styles.more} href="/blog">More posts</a>
      </section>
    )}

    {mumblings.length > 0 && (
      <section class={styles.section} aria-labelledby="mumblings-title">
        <div class={styles.sectionHeading}>
          <h2 id="mumblings-title">Mumblings</h2>
        </div>
        <ul class={styles.entries} role="list">
          {mumblings.map(mumbling => (
            <li>
              <a href={linkSlugFor(mumbling)}>{mumbling.data.title}</a>
            </li>
          ))}
        </ul>
        <a class={styles.more} href="/mumblings">More mumblings</a>
      </section>
    )}

    <p class={styles.resume}><a target="_blank" rel="noopener" href="/assets/resume/Matt-Bidewell-Resume.pdf">Résumé</a></p>
  </div>
</BaseLayout>
