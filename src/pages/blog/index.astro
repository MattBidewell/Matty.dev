---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogLinks from "../../components/home/blogLinks/BlogLinks.astro";
import { categoryOf, getLivePosts } from "../../lib/posts";

const posts = (await getLivePosts()).filter((post) => categoryOf(post) !== "project");
---

<BaseLayout title="Posts">
  <div class="container">
    <BlogLinks posts={posts} hasLimit={false} title="Posts" sectionId="posts" />
  </div>
</BaseLayout>
