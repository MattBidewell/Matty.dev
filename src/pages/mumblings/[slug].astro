---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostBody from "../../components/blog/body/PostBody.astro";
import PostFooter from "../../components/blog/footer/PostFooter.astro";
import PostHeader from "../../components/blog/PostHeader.astro";
import styles from "../../components/blog/Post.module.css";
import { categoryOf, getLivePosts, rawSlug, readingStats } from "../../lib/posts";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getLivePosts("mumbling");
  return posts.map((post) => ({
    params: { slug: rawSlug(post) },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, headings } = await post.render();
const stats = readingStats(post);
const slug = rawSlug(post);
const shareUrl = `https://matty.dev/mumblings/${slug}`;
const ogImage = `https://matty.dev/mumblings/${slug}/opengraph-image.png`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt ?? ""}
  ogType="article"
  ogImage={ogImage}
  canonical={shareUrl}
  kind="post"
  toc={headings}
  stats={stats}
>
  <article class={styles.post}>
    <PostHeader
      category={categoryOf(post)}
      title={post.data.title}
      excerpt={post.data.excerpt}
      stats={stats}
    />
    <PostBody>
      <Content />
    </PostBody>
    <PostFooter shareUrl={shareUrl} shareTitle={post.data.title} />
  </article>
</BaseLayout>
