---
import styles from "./BlogLinks.module.css";
import { formatDate, linkSlugFor, type PostEntry } from "../../../lib/posts";

interface Props {
  posts: PostEntry[];
  hasLimit: boolean;
  title?: string;
  moreLinkLabel?: string;
  moreLinkHref?: string;
  sectionId?: string;
  intro?: string;
}

const {
  posts,
  hasLimit,
  title = "Blog posts",
  moreLinkLabel = "More posts...",
  moreLinkHref = "/blog",
  sectionId,
  intro,
} = Astro.props;
const Heading = hasLimit ? "h2" : "h1";
const EntryHeading = hasLimit ? "h3" : "h2";
---

<section class={styles.bloglinks_content}>
  <header class={styles.header}>
    <Heading
      id={sectionId}
      class:list={[styles.title, !hasLimit && styles["page-title"]]}
    >
      {title}
    </Heading>
    {intro && <p class={styles.intro}>{intro}</p>}
  </header>
  <ul class={styles.entries} role="list">
    {
      posts.map((post) => {
        const href = linkSlugFor(post);
        return (
          <li class={styles.entry}>
            <article>
              <EntryHeading class={styles["entry-title"]}>
                <a href={href}>{post.data.title}</a>
              </EntryHeading>
              {post.data.excerpt && <p class={styles.excerpt}>{post.data.excerpt}</p>}
              <time class={styles.date} datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </article>
          </li>
        );
      })
    }
  </ul>
  {
    hasLimit && (
      <p class={styles["more-link"]}>
        <a href={moreLinkHref}>{moreLinkLabel}</a>
      </p>
    )
  }
</section>
