---
import styles from "./ProjectLinks.module.css";
import { formatDate, linkSlugFor, type PostEntry } from "../../../lib/posts";

interface Props {
  projects: PostEntry[];
  hasLimit: boolean;
}

const { projects, hasLimit } = Astro.props;
const Heading = hasLimit ? "h2" : "h1";
const EntryHeading = hasLimit ? "h3" : "h2";
---

<section class={styles.projectlinks_content}>
  <Heading class:list={[styles.title, !hasLimit && styles["page-title"]]}>
    Projects
  </Heading>
  <ul class={styles.entries} role="list">
    {
      projects.map((project) => {
        const href = linkSlugFor(project);
        return (
          <li class={styles.entry}>
            <article>
              <EntryHeading class={styles["entry-title"]}>
                <a href={href}>{project.data.title}</a>
              </EntryHeading>
              {project.data.excerpt && <p class={styles.excerpt}>{project.data.excerpt}</p>}
              <time class={styles.date} datetime={project.data.date.toISOString()}>
                {formatDate(project.data.date)}
              </time>
            </article>
          </li>
        );
      })
    }
  </ul>
  {
    hasLimit && (
      <p class={styles["more-link"]}>
        <a href="/projects">More projects...</a>
      </p>
    )
  }
</section>
