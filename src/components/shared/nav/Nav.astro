---
import styles from "./Nav.module.css";

const links = [
  { href: "/blog", label: "Writing" },
  { href: "/mumblings", label: "Mumblings" },
  { href: "/projects", label: "Projects" },
  { href: "/bookshelf", label: "Bookshelf" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

  <nav class={styles.nav} aria-label="Main">
  <ul>
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class={`${styles.link} ${isActive(link.href) ? styles.active : ""}`.trim()}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <button
        class={styles.themeToggle}
        data-theme-toggle
        aria-label="Switch to dark theme"
        type="button"
      >
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6 2h8v2h2v2h2v8h-2v2h-2v2H6v-2H4v-2H2V6h2V4h2zm4 2H6v2H4v8h2v2h4z" /></svg>
      </button>
    </li>
  </ul>
</nav>
