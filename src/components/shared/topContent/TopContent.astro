---
import styles from './main.module.css';
import Nav from '../nav/Nav.astro';
import AsciiMark from '../AsciiMark.astro';
import Icon, { type IconName } from '../Icon.astro';

const socials: { href: string; label: string; icon: IconName; external?: boolean }[] = [
  { href: 'https://github.com/MattBidewell', label: 'GitHub', icon: 'github', external: true },
  { href: 'https://x.com/MattBidewell', label: 'X', icon: 'x', external: true },
  { href: 'https://www.linkedin.com/in/matt-bidewell-a4578790/', label: 'LinkedIn', icon: 'linkedin', external: true },
  { href: '/rss.xml', label: 'RSS', icon: 'rss' },
];
---

<header class:list={['sidebar', styles.header]}>
  <div class={styles.masthead}>
    <a class={styles.brand} href="/" aria-label="matty.dev">
      <AsciiMark />
      <span>matty<span class={styles.dot}>.</span>dev</span>
    </a>
    <p class={styles.subtitle}>Software, systems, and the bits in between.</p>
  </div>
  <button class={styles.menuToggle} id="menuToggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="navRail" type="button">menu <span class={styles.menuState} aria-hidden="true"></span></button>
  <div class={styles.navigation} id="navRail">
    <Nav />
    <ul class={styles.socials} role="list">
      {socials.map(social => (
        <li>
          <a
            href={social.href}
            aria-label={social.label}
            title={social.label}
            {...(social.external ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
          >
            <Icon name={social.icon} />
          </a>
        </li>
      ))}
      <li>
        <button class={styles.themeToggle} data-theme-toggle aria-label="Switch to dark theme" type="button">
          <Icon name="moon" class={styles.moon} />
          <Icon name="sun" class={styles.sun} />
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  let controller: AbortController | undefined;
  function setup() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const toggle = document.getElementById('menuToggle');
    const rail = document.getElementById('navRail');
    if (!toggle || !rail) return;
    function close() {
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Open navigation menu');
      delete rail!.dataset.open;
    }
    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') return close();
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      rail.dataset.open = '';
    }, { signal });
    rail.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('a')) close();
    }, { signal });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !toggle.contains(event.target) && !rail.contains(event.target)) close();
    }, { signal });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    }, { signal });
    matchMedia('(min-width: 901px)').addEventListener('change', close, { signal });
  }
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
