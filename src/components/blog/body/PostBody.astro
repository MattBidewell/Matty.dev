---
// Keep the page title as the only h1 without changing the source posts.
const content = (await Astro.slots.render("default")).replace(/<(\/?)h1(?=[\s>])/g, "<$1h2");
---

<div class="post-body" set:html={content} />

<style>
  .post-body {
    width: 100%;
    min-width: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    overflow-wrap: anywhere;
  }

  .post-body :global(p) {
    margin: 0 0 1.5rem;
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin: 2.5rem 0 1rem;
    font-family: var(--font-display);
    line-height: 1.3;
    scroll-margin-top: 2rem;
  }

  .post-body :global(h2) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    font-size: 1.375rem;
  }

  .post-body > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .post-body :global(h3) {
    font-size: 1.125rem;
  }

  .post-body :global(h4) {
    font-size: 1rem;
  }

  .post-body :global(h2::before),
  .post-body :global(h3::before) {
    content: "§ ";
    color: var(--accent-primary);
    font-weight: 400;
  }

  .post-body :global(ul) {
    padding-left: 1.5rem;
    list-style: none;
  }

  .post-body :global(ul > li::before) {
    content: "─";
    display: inline-block;
    width: 1.5rem;
    margin-left: -1.5rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .post-body :global(img),
  .post-body :global(video) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
  }

  .post-body :global(figure) {
    margin: 2rem 0;
  }

  .post-body :global(figcaption) {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .post-body :global(pre) {
    max-width: 100%;
    margin: 2rem 0;
  }

  .post-body :global(pre code) {
    overflow-wrap: normal;
    white-space: pre;
  }

  .post-body :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--accent-primary);
  }

  .post-body :global(:not(pre) > code::before),
  .post-body :global(:not(pre) > code::after) {
    content: "`";
    color: var(--text-muted);
  }

  .post-body :global(blockquote) {
    margin: 2rem 0;
  }

  .post-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.9375rem;
  }

  .post-body :global(hr) {
    margin: 2.5rem 0;
  }
</style>
