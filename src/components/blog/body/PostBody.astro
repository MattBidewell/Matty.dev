---
// Keep the page title as the only h1 without changing the source posts.
const content = (await Astro.slots.render("default")).replace(/<(\/?)h1(?=[\s>])/g, "<$1h2");
---

<div class="post-body" set:html={content} />

<style>
  .post-body {
    width: 100%;
    min-width: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .post-body :global(p) {
    margin: 0 0 1.5rem;
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin: 2.5rem 0 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .post-body :global(h2) {
    font-size: 2rem;
  }

  .post-body :global(h3) {
    font-size: 1.5rem;
  }

  .post-body :global(h4) {
    font-size: 1.25rem;
  }

  .post-body :global(img),
  .post-body :global(video) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 0;
  }

  .post-body :global(figure) {
    margin: 2rem 0;
  }

  .post-body :global(figcaption) {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .post-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 0;
    margin: 2rem 0;
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8em;
    border-radius: 0;
  }

  .post-body :global(pre code) {
    font-size: 0.85rem;
    overflow-wrap: normal;
    white-space: pre;
  }

  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 3px solid var(--brand-soft);
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: 1rem;
  }

  .post-body :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--border-color);
  }
</style>
