---
import styles from "./PostFooter.module.css";

interface Props {
  shareUrl?: string;
  shareTitle?: string;
}

const { shareUrl, shareTitle } = Astro.props;

const encodedUrl = shareUrl ? encodeURIComponent(shareUrl) : "";
const encodedTitle = shareTitle ? encodeURIComponent(shareTitle) : "";
---

<footer class={styles["post-footer"]}>
  {
    shareUrl && shareTitle && (
      <div class={styles["share-links"]}>
        <span class={styles["share-label"]}>Share</span>
        <a
          href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
          target="_blank"
          rel="noreferrer"
          aria-label="Share on X"
        >
          X
        </a>
        <span class={styles.separator}>·</span>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
          target="_blank"
          rel="noreferrer"
          aria-label="Share on LinkedIn"
        >
          LinkedIn
        </a>
      </div>
    )
  }
</footer>
